NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key for AES-256-GCM, as 64 hex chars or base64. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Shared secret the external scheduler sends as the x-cron-secret header
# when calling POST /api/cron/poll-usage. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional. A Slack Incoming Webhook URL. If unset, alerts still show on the
# dashboard — the cron job just skips the Slack POST.
SLACK_WEBHOOK_URL=
